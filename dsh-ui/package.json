{
  "name": "dsh-chem-ui",
  "version": "0.0.1",
  "private": true,
  "description": "化学工作台（DSH Web UI 插件）：左侧栏入口 + 分子画板（Ketcher）+ 把结构交给 agent",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "chemistry",
    "ketcher",
    "molecule-editor"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
